      {
        "platforms": [
          "linux",
          "macos"
        ],
        "command": [
          "cargo",
          "build",
          "--release"
        ]
      }
    ],
    "actions": [
      {
        "id": "toggle",
        "title": "Last workspace",
        "contexts": [
          "global",
          "workspace"
        ],
        "command": [
          "./target/release/herdr-last-workspace",
          "toggle"
        ]
      }
    ],
    "events": [
